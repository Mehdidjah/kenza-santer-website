{
  "name": "kenz-sante",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <26",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --tsconfig server/tsconfig.json server/src/main.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:all": "npm run build && npm run build:server",
    "build:server": "prisma generate --schema server/prisma/schema.prisma && tsc -p server/tsconfig.build.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:server": "node server/dist/main.js",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "admin:create": "tsx server/scripts/create-admin.ts",
    "import:legacy": "tsx server/scripts/import-legacy-export.ts",
    "seed:catalog": "tsx server/scripts/seed-catalog.ts"
  },
