generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
}

model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  brand           String         @default("")
  categoryId      String         @db.Uuid
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description     String         @default("")
  fullDescription String         @default("")
  price           Decimal        @default(0) @db.Decimal(12, 2)
  originalPrice   Decimal?       @db.Decimal(12, 2)
  badge           String?
  rating          Decimal        @default(4.5) @db.Decimal(3, 2)
  reviewCount     Int            @default(0)
  inStock         Boolean        @default(true)
  ingredients     String[]       @default([])
  howToUse        String[]       @default([])
  precautions     String[]       @default([])
  images          ProductImage[]
  orderItems      OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([categoryId])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  objectKey String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  phone     String
  email     String
  wilaya    String
  commune   String
  notes     String?
  total     Decimal     @default(0) @db.Decimal(12, 2)
  status    OrderStatus @default(pending)
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?  @db.Uuid
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}
